# Environment variables for Viral Clip Forge v2.0
# Copy this to .env and fill in the values

# Server (API backend, proxied by Vite on :3000)
PORT=3001

# Better Auth
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=

# OpenRouter (free models)
OPENROUTER_API_KEY=

# Stripe (test mode keys from dashboard.stripe.com/test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_1XXX...   # Pro monthly ($29)
STRIPE_PRICE_AGENCY=price_1XXX... # Agency monthly ($99)

# Public URL (for OAuth callbacks, webhooks)
PUBLIC_BASE_URL=http://localhost:3000

# Optional: S3-compatible storage (if not set, uses local filesystem)
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Optional: Social OAuth (for scheduler)
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Admin panel credentials
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=securepassword

# Feature flags
# ENABLE_STRIPE=true