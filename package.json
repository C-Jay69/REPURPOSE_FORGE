    "@ai-sdk/svelte": "^0.0.15",
    "@ai-sdk/vue": "^0.0.15",
    "@auth/core": "^0.28.0",
    "@auth/drizzle-adapter": "^0.2.0",
    "@tanstack/react-query": "^5.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "ai": "^7.0.59",
    "autoprefixer": "^10.4.12",
    "better-auth": "^0.3.0",
    "better-sqlite3": "11",
    "class-variance-authority": "^0.4.0",
    "clsx": "^1.2.1",
    "concurrently": "^7.6.0",
    "dotenv": "^16.0.3",
    "drizzle-orm": "^0.28.1",
    "hono": "^3.11.0",
    "lucide-react": "^0.244.0",
