{
  "name": "viral-clip-forge",
  "version": "2.0.0",
  "private": true,
  "description": "Viral Clip Forge v2.0 - AI-powered video clip creation platform",
  "scripts": {
    "dev": "concurrently \"bun run dev:client\" \"bun run dev:server\"",
    "dev:client": "vite",
    "dev:server": "bun run --watch src/server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun run src/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
